<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#FFF5F5F5"
    tools:context=".SecondActivity">

    <TextView
        android:id="@+id/tvIp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Conectado a:"
        android:textSize="14sp"
        android:textColor="#FF666666"
        android:padding="12dp"
        android:background="#FFFFFFFF"
        android:elevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="8dp" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardEstado"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvIp">

        <TextView
            android:id="@+id/tvEstadoVentana"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ventana cerrada"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="32dp"
            android:textColor="#FF4CAF50" />
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnReset"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Reset"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="20dp"
        android:enabled="false"
        android:backgroundTint="#FF2196F3"
        android:textColor="#FFFFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardEstado"
        android:layout_marginTop="32dp" />

    <TextView
        android:id="@+id/tvMensaje"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="16sp"
        android:gravity="center"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnReset"
        android:layout_marginTop="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>

